# Design assets — local-only, never commit.
# The JSX prototype was extracted into the sibling Counting-Admin repo
# under docs/designs/raw/. This folder stays on disk as a backup but
# must not end up in the phone app's git history.
Design/

# Scratch / editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Ignore node_modules in case dev tooling ever gets introduced locally
node_modules/

# Supabase CLI working directory — caches linked-project ref + diff state.
# Not source code; rebuilds itself when `supabase link` / `supabase status`
# runs. Keep out of git history.
supabase/.temp/

# One-shot SQL artifacts emitted by scripts/ (the *.mjs files themselves
# stay tracked, but their generated outputs don't).
scripts/_*.sql
scripts/_*.log
